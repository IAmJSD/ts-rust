#!/usr/bin/env bash
# Refuses a push to the public repo that would bring back what the 2026-10-07 history cleanup removed.
# The history before the cleanup is in the private pingdotgg/ts-rust-archive. About 2,000 old local
# branches and worktrees still sit on it, and one push of one of them would publish it all again.
#
# It refuses a push when a commit that origin does not have yet has the author or committer email
# me@theo.li. Every old branch has such commits on its path, and new commits use the noreply address
# that the repo config sets (git config user.email). The removed strings are not named here, so this
# file can be public.
# It only checks pushes to origin. Install: scripts/git-hooks/install.sh
set -euo pipefail
remote=$1
[[ $remote == origin ]] || exit 0
zero=0000000000000000000000000000000000000000
fail=0
while read -r local_ref local_sha _remote_ref _remote_sha; do
  [[ $local_sha == "$zero" ]] && continue
  # grep reads all input (no -q): with pipefail, an early exit would SIGPIPE rev-list and hide a match.
  if git rev-list "$local_sha" --not --remotes=origin --format='%ae %ce' | grep 'me@theo\.li' > /dev/null; then
    echo "pre-push: $local_ref has commits from the history before the 2026-10-07 cleanup (or with me@theo.li)." >&2
    echo "pre-push: rebase it onto origin (target/repo-rewrite-2026-10-07/commit-map maps old to new SHAs)." >&2
    fail=1
  fi
done
exit $fail
